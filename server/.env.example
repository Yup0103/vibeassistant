# --- App auth (v0 = single user) ---
APP_USER_EMAIL=you@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_USER_PASSWORD_HASH=
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# --- Mode ---
# true = use the in-memory mock agent (no external accounts needed)
# false = use the real Anthropic Managed Agents integration below
MOCK_MODE=true

# --- Real mode only: Anthropic Managed Agents ---
ANTHROPIC_API_KEY=
# Filled in by `npm run setup-agent` after it creates the Agent + Environment once
MA_AGENT_ID=
MA_ENVIRONMENT_ID=

# --- Real mode only: MCP servers ---
KITE_MCP_URL=https://mcp.kite.trade/mcp

SWIGGY_MCP_URL=
SWIGGY_CLIENT_ID=
SWIGGY_REDIRECT_URI=http://localhost:5174/swiggy/oauth/callback

# --- Misc ---
PORT=5174
DB_PATH=./data.sqlite
